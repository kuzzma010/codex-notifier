<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex ждёт тебя" Width="168" Height="64" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="Segoe UI">
 <Border x:Name="Shell" Margin="6" Padding="6" CornerRadius="16" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/></Border.Effect>
  <Grid>
   <Grid x:Name="Mini"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Button x:Name="MiniOpen" Content="Открыть" Style="{DynamicResource Primary}"/><Button x:Name="Expand" Grid.Column="1" Content="⋯" FontSize="19" Padding="4" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Развернуть уведомление"/></Grid>
   <Grid x:Name="Detail" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="CloseNotice" Content="×" DockPanel.Dock="Right" Padding="6,0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Увидел: закрыть уведомление"/><Button x:Name="Collapse" Content="⌄" DockPanel.Dock="Right" Padding="6,0" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Свернуть уведомление"/><TextBlock Text="✓  Codex" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="Ответ готов" Grid.Row="1" FontSize="19" FontWeight="Medium" Margin="0,15,0,6"/>
    <TextBlock x:Name="TaskTitle" Grid.Row="2" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Muted}"/>
    <TextBlock x:Name="Countdown" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,17,0,8"/>
    <Border x:Name="Track" Grid.Row="4" Background="{DynamicResource Soft}" CornerRadius="2"><Border x:Name="Progress" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left"/></Border>
    <Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="OpenChat" Content="Открыть чат" Style="{DynamicResource Primary}" Margin="0,0,4,0"/><Button x:Name="Seen" Content="Увидел" Grid.Column="1" Margin="4,0,0,0"/></Grid>
    <StackPanel x:Name="Replies" Grid.Row="6" Margin="0,13,0,0"><TextBlock x:Name="ReplyHint" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><UniformGrid Columns="3"><Button x:Name="ReplyYes" Content="Да" Padding="5,6" Margin="0,0,3,0"/><Button x:Name="ReplyNext" Content="Дальше" Padding="5,6" Margin="3,0,3,0"/><Button x:Name="ReplyDo" Content="Делай" Padding="5,6" Margin="3,0,0,0"/></UniformGrid></StackPanel>
    <TextBlock x:Name="ReplyStatus" Grid.Row="7" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
   </Grid>
  </Grid>
 </Border>
</Window>
